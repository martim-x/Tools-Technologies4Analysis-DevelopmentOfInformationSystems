@startuml System Architecture
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 15
skinparam linetype ortho
skinparam arrowColor black
skinparam arrowThickness 1

' Компоненты системы
[Ngrok] as ngrok
[Nginx] as nginx
[Daphne] as daphne
[Django] as django
[Redis] as redis
[Elasticsearch] as elastic
[Kibana] as kibana
[Logstash] as logstash

' База данных
database "PostgreSQL" as postgres

' Связи
ngrok --> nginx : HTTPS
nginx --> daphne : WebSocket/HTTP
daphne --> django : ASGI
django --> postgres : ORM
django --> redis : Cache
django --> elastic : Search
elastic --> kibana : Data
logstash --> elastic : Logs
postgres --> elastic : "Индексация\nданных"

' Группировка компонентов
package "Frontend" {
    [React] as react
    react --> nginx : HTTP/WS
}

package "Backend" {
    [Nginx] as nginx2
    [Daphne] as daphne2
    [Django] as django2
    [Redis] as redis2
}

package "ELK Stack" {
    [Elasticsearch] as elastic2
    [Kibana] as kibana2
    [Logstash] as logstash2
}

' Заметки
note right of ngrok : Туннелирование и SSL
note right of nginx : Прокси-сервер и балансировщик
note right of daphne : ASGI сервер для WebSocket
note right of redis : Кэширование и очередь задач
note right of elastic : Поисковый движок и хранилище логов
note right of kibana : Визуализация и анализ данных
note right of logstash : Сбор и обработка логов
note right of postgres : Основное хранилище данных

@enduml
