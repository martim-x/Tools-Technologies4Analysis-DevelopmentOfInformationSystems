@startuml Physical_Schema_Car_Leasing_Full
skinparam roundcorner 5
skinparam monochrome false
skinparam shadowing false
skinparam arrowColor #660033
skinparam classBackgroundColor #F0F8FF
skinparam classBorderColor #660033
skinparam classArrowColor #660033

hide circle
hide empty members

' === CORE APPLICATION TABLES ===
class car_leasing_app_brand {
  + id: BIGSERIAL <<PK>>
  --
  brand_name: TEXT
}

class car_leasing_app_car {
  + id: BIGSERIAL <<PK>>
  --
  car_name: TEXT
  history: TEXT
  description: TEXT
  shortdescription: TEXT
  advantages: TEXT
  fuel_capacity_or_battery_capacity: DOUBLE PRECISION
  leasing_rate: DOUBLE PRECISION
  max_range: DOUBLE PRECISION
  original_price_usd: DOUBLE PRECISION
  # brand_name_id: INTEGER <<FK>>
  # drive_type_id: INTEGER <<FK>>
  # passenger_capacity_id: INTEGER <<FK>>
  # transmission_type_id: INTEGER <<FK>>
  # usage_type_id: INTEGER <<FK>>
  --
  <<index>> idx_car_brand
  <<index>> idx_car_price
  <<index>> idx_car_leasing_rate
}

class car_leasing_app_extendeduser {
  + id: BIGSERIAL <<PK>>
  --
  password: VARCHAR(128)
  last_login: TIMESTAMP
  is_superuser: BOOLEAN
  username: VARCHAR(150)
  first_name: VARCHAR(150)
  last_name: VARCHAR(150)
  email: VARCHAR(254) <<UNIQUE>>
  is_staff: BOOLEAN
  is_active: BOOLEAN
  date_jointed: TIMESTAMP
  is_banned: BOOLEAN
  --
  <<index>> idx_user_email
  <<index>> idx_user_active
}

class car_leasing_app_leasingform {
  + id: BIGSERIAL <<PK>>
  --
  created_at: TIMESTAMP
  period: INTEGER
  down_payment: INTEGER
  monthly_payment: DOUBLE PRECISION
  # car_id: INTEGER <<FK>>
  # chat_id: INTEGER <<FK>>
  # consumer_id: INTEGER <<FK>>
  # manager_id: INTEGER <<FK>>
  # holder_id: INTEGER <<FK>>
  --
  <<index>> idx_leasing_car
  <<index>> idx_leasing_consumer
  <<index>> idx_leasing_created
}

class car_leasing_app_message {
  + id: BIGSERIAL <<PK>>
  --
  content: TEXT
  created_at: TIMESTAMP
  is_read_by_receiver: BOOLEAN
  is_pinned: BOOLEAN
  is_deleted: BOOLEAN
  # chat_id: INTEGER <<FK>>
  # sender_id: INTEGER <<FK>>
  # reply_to_id: INTEGER <<FK>>
  --
  <<index>> idx_message_chat
  <<index>> idx_message_sender
  <<index>> idx_message_created
}

' === M2M TABLES ===
class car_leasing_app_extendeduser_favorite_cars {
  + id: BIGSERIAL <<PK>>
  --
  # extendeduser_id: INTEGER <<FK>>
  # car_id: INTEGER <<FK>>
  --
  <<unique>> uk_user_favorite_car
}

class car_leasing_app_extendeduser_chats {
  + id: BIGSERIAL <<PK>>
  --
  # extendeduser_id: INTEGER <<FK>>
  # chat_id: INTEGER <<FK>>
  --
  <<unique>> uk_user_chat
}

' === DJANGO AUTH TABLES ===
class auth_group {
  + id: BIGSERIAL <<PK>>
  --
  name: VARCHAR(150) <<UNIQUE>>
}

class auth_permission {
  + id: BIGSERIAL <<PK>>
  --
  name: VARCHAR(255)
  # content_type_id: INTEGER <<FK>>
  codename: VARCHAR(100)
  --
  <<unique>> uk_permission_content_type_codename
}

' === DJANGO ACCOUNT TABLES ===
class account_emailaddress {
  + id: BIGSERIAL <<PK>>
  --
  email: VARCHAR(254)
  verified: BOOLEAN
  primary: BOOLEAN
  # user_id: INTEGER <<FK>>
  --
  <<unique>> uk_email
}

' === DJANGO SYSTEM TABLES ===
class django_admin_log {
  + id: BIGSERIAL <<PK>>
  --
  action_time: TIMESTAMP
  object_id: TEXT
  object_repr: VARCHAR(200)
  action_flag: SMALLINT
  change_message: TEXT
  # content_type_id: INTEGER <<FK>>
  # user_id: INTEGER <<FK>>
  --
  <<index>> idx_admin_log_content_type
  <<index>> idx_admin_log_user
}

class django_session {
  + session_key: VARCHAR(40) <<PK>>
  --
  session_data: TEXT
  expire_date: TIMESTAMP
  --
  <<index>> idx_session_expire_date
}

' === SOCIAL AUTH TABLES ===
class socialaccount_socialaccount {
  + id: BIGSERIAL <<PK>>
  --
  provider: VARCHAR(200)
  uid: VARCHAR(191)
  last_login: TIMESTAMP
  date_jointed: TIMESTAMP
  extra_data: TEXT
  # user_id: INTEGER <<FK>>
  --
  <<unique>> uk_socialaccount_provider_uid
}

' === KEY RELATIONSHIPS ===
car_leasing_app_brand ||--o{ car_leasing_app_car : "ON DELETE SET NULL"
car_leasing_app_car ||--o{ car_leasing_app_leasingform : "ON DELETE SET NULL"
car_leasing_app_extendeduser ||--o{ car_leasing_app_leasingform : "ON DELETE SET NULL"
car_leasing_app_extendeduser ||--o{ django_admin_log : "ON DELETE CASCADE"
car_leasing_app_extendeduser ||--o{ socialaccount_socialaccount : "ON DELETE CASCADE"

car_leasing_app_extendeduser }o--|| car_leasing_app_extendeduser_favorite_cars
car_leasing_app_car }o--|| car_leasing_app_extendeduser_favorite_cars

note right of car_leasing_app_car
  <b>СУБД:</b> PostgreSQL 17.4
  <b>Размер записи:</b> ~2KB
  <b>Индексы:</b> 3 B-tree
  <b>Ожидаемый размер:</b> 10,000 записей
end note

note right of car_leasing_app_extendeduser
  <b>СУБД:</b> PostgreSQL 17.4
  <b>Размер записи:</b> ~1KB
  <b>Индексы:</b> 2 B-tree
  <b>Ожидаемый размер:</b> 50,000 записей
end note

legend bottom
  | Обозначения | |
  | **+** | Публичное поле / Первичный ключ |
  | **#** | Внешний ключ (Protected) |
  | <<PK>> | Первичный ключ |
  | <<FK>> | Внешний ключ |
  | <<UNIQUE>> | Уникальное ограничение |
  | <<index>> | Индекс базы данных |
end legend

@enduml