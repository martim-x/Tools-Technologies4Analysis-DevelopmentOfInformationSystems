@startuml Physical_Schema_Car_Leasing_Clean
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam arrowThickness 1

hide circle
hide empty members

' === PHYSICAL TABLES (CLEAN VERSION) ===

class car_leasing_app_brand {
  + id: BIGSERIAL <<PK>>
  --
  brand_name: TEXT
}

class car_leasing_app_usagetype {
  + id: BIGSERIAL <<PK>>
  --
  usage_type: TEXT
}

class car_leasing_app_passengercapacity {
  + id: BIGSERIAL <<PK>>
  --
  passenger_capacity: INTEGER
}

class car_leasing_app_transmissiontype {
  + id: BIGSERIAL <<PK>>
  --
  transmission_type: TEXT
}

class car_leasing_app_drivetype {
  + id: BIGSERIAL <<PK>>
  --
  drive_type: TEXT
}

class car_leasing_app_car {
  + id: BIGSERIAL <<PK>>
  --
  car_name: TEXT
  history: TEXT
  description: TEXT
  shortdescription: TEXT
  advantages: TEXT
  fuel_capacity_or_battery_capacity: DOUBLE PRECISION
  leasing_rate: DOUBLE PRECISION
  max_range: DOUBLE PRECISION
  original_price_usd: DOUBLE PRECISION
  --
  brand_name_id: INTEGER <<FK>>
  drive_type_id: INTEGER <<FK>>
  passenger_capacity_id: INTEGER <<FK>>
  transmission_type_id: INTEGER <<FK>>
  usage_type_id: INTEGER <<FK>>
}

class car_leasing_app_carimage {
  + id: BIGSERIAL <<PK>>
  --
  image: TEXT
  --
  car_id: INTEGER <<FK>>
}

class car_leasing_app_extendeduser {
  + id: BIGSERIAL <<PK>>
  --
  username: VARCHAR(150)
  email: VARCHAR(254)
  first_name: VARCHAR(150)
  last_name: VARCHAR(150)
  is_active: BOOLEAN
  is_banned: BOOLEAN
}

class car_leasing_app_message {
  + id: BIGSERIAL <<PK>>
  --
  content: TEXT
  created_at: TIMESTAMP
  --
  chat_id: INTEGER <<FK>>
  sender_id: INTEGER <<FK>>
  reply_to_id: INTEGER <<FK>>
}

class car_leasing_app_leasingform {
  + id: BIGSERIAL <<PK>>
  --
  created_at: TIMESTAMP
  period: INTEGER
  down_payment: INTEGER
  monthly_payment: DOUBLE PRECISION
  --
  car_id: INTEGER <<FK>>
  consumer_id: INTEGER <<FK>>
  manager_id: INTEGER <<FK>>
  holder_id: INTEGER <<FK>>
}

' === RELATIONSHIPS ===
car_leasing_app_brand ||--o{ car_leasing_app_car
car_leasing_app_usagetype ||--o{ car_leasing_app_car
car_leasing_app_passengercapacity ||--o{ car_leasing_app_car
car_leasing_app_transmissiontype ||--o{ car_leasing_app_car
car_leasing_app_drivetype ||--o{ car_leasing_app_car

car_leasing_app_car ||--o{ car_leasing_app_carimage
car_leasing_app_car ||--o{ car_leasing_app_leasingform

car_leasing_app_extendeduser ||--o{ car_leasing_app_message
car_leasing_app_extendeduser ||--o{ car_leasing_app_leasingform

@enduml
